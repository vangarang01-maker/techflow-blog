---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, AUTHOR, ADSENSE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** `article` emits BlogPosting structured data and article OG tags. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  category?: string;
  tags?: string[];
  /** Override the canonical URL (defaults to the current page). */
  canonical?: string;
  noindex?: boolean;
  /** Ordered crumbs, excluding the site root. */
  breadcrumbs?: { name: string; url: string }[];
  /** Estimated reading time in minutes, used by BlogPosting. */
  readingMinutes?: number;
  bodyClass?: string;
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = AUTHOR.name,
  category,
  tags = [],
  canonical,
  noindex = false,
  breadcrumbs = [],
  readingMinutes,
  bodyClass = '',
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? SITE.url;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, `${siteUrl}/`).href;
const socialImage = new URL(image, `${siteUrl}/`).href;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const logoUrl = new URL('/logo.svg', `${siteUrl}/`).href;

const organization = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: SITE.name,
  url: `${siteUrl}/`,
  description: SITE.description,
  logo: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}/#logo`,
    url: logoUrl,
    width: 512,
    height: 512,
    caption: SITE.name,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: SITE.email,
    availableLanguage: ['ko', 'en'],
  },
};

const website = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: `${siteUrl}/`,
  name: SITE.name,
  description: SITE.description,
  inLanguage: SITE.lang,
  publisher: { '@id': `${siteUrl}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/blog/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const person = {
  '@type': 'Person',
  '@id': `${siteUrl}/#author`,
  name: author,
  description: AUTHOR.bio,
  jobTitle: AUTHOR.role,
  url: new URL('/about', `${siteUrl}/`).href,
  worksFor: { '@id': `${siteUrl}/#organization` },
};

const blogPosting =
  type === 'article' && publishedTime
    ? {
        '@type': 'BlogPosting',
        '@id': `${canonicalUrl}#article`,
        isPartOf: { '@id': `${siteUrl}/#website` },
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
        headline: title,
        description,
        image: [socialImage],
        datePublished: publishedTime.toISOString(),
        dateModified: (modifiedTime ?? publishedTime).toISOString(),
        author: { '@id': `${siteUrl}/#author` },
        publisher: { '@id': `${siteUrl}/#organization` },
        inLanguage: SITE.lang,
        ...(category ? { articleSection: category } : {}),
        ...(tags.length ? { keywords: tags.join(', ') } : {}),
        ...(readingMinutes ? { timeRequired: `PT${readingMinutes}M` } : {}),
      }
    : null;

const breadcrumbList = breadcrumbs.length
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [{ name: '홈', url: '/' }, ...breadcrumbs].map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.url, `${siteUrl}/`).href,
      })),
    }
  : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, person, blogPosting, breadcrumbList].filter(Boolean),
};

const adsenseClient = ADSENSE.client;
const adsenseEnabled = ADSENSE.enabled && adsenseClient !== '';
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content={author} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title ?? SITE.title} />
    {
      type === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      type === 'article' && (modifiedTime ?? publishedTime) && (
        <meta
          property="article:modified_time"
          content={(modifiedTime ?? publishedTime)!.toISOString()}
        />
      )
    }
    {type === 'article' && category && <meta property="article:section" content={category} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title ?? SITE.title} />

    <!-- Icons & feeds -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} RSS`}
      href={new URL('rss.xml', `${siteUrl}/`).href}
    />

    <!-- Google AdSense: site verification + optimized async serving -->
    {adsenseEnabled && <meta name="google-adsense-account" content={adsenseClient} />}
    {
      adsenseEnabled && (
        <script is:inline define:vars={{ adsenseClient }}>
          (() => {
            let loaded = false;
            function loadAdSense() {
              if (loaded) return;
              loaded = true;
              const s = document.createElement('script');
              s.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`;
              s.async = true;
              s.crossOrigin = 'anonymous';
              document.head.appendChild(s);
            }
            ['scroll', 'touchstart', 'mousemove', 'keydown', 'click'].forEach((e) => {
              window.addEventListener(e, loadAdSense, { once: true, passive: true });
            });
            if ('requestIdleCallback' in window) {
              window.requestIdleCallback(loadAdSense, { timeout: 3500 });
            } else {
              setTimeout(loadAdSense, 3000);
            }
          })();
        </script>
      )
    }

    <script is:inline>
      // Applied before paint so the stored theme never flashes the wrong colors.
      (() => {
        try {
          const stored = localStorage.getItem('techflow-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
