---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { CATEGORIES, categorySlug } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const countByCategory = (name: string) =>
  posts.filter((post) => post.data.category === name).length;
---

<Layout
  title="전체 글"
  description="생산성, 맥 & PC, 스마트 도구, 워크플로우까지. TechFlow가 직접 검증하고 발행한 모든 글을 카테고리별로 모았습니다."
  breadcrumbs={[{ name: '전체 글', url: '/blog' }]}
>
  <div class="container-page page">
    <header class="page__head">
      <p class="page__eyebrow">Archive</p>
      <h1>전체 글</h1>
      <p class="page__desc">
        총 {posts.length}편의 글이 있습니다. 카테고리를 고르거나 제목·태그로 검색해 보세요.
      </p>
    </header>

    <div class="toolbar">
      <div class="filters" role="group" aria-label="카테고리 필터">
        <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">
          전체 <span class="filter__count">{posts.length}</span>
        </button>
        {
          CATEGORIES.map((category) => (
            <button
              type="button"
              class="filter"
              data-filter={category.slug}
              aria-pressed="false"
            >
              <span aria-hidden="true">{category.icon}</span> {category.name}
              <span class="filter__count">{countByCategory(category.name)}</span>
            </button>
          ))
        }
      </div>

      <div class="search">
        <label class="sr-only" for="post-search">글 검색</label>
        <input
          id="post-search"
          type="search"
          placeholder="제목이나 태그로 검색"
          autocomplete="off"
        />
      </div>
    </div>

    <p class="result-count" id="result-count" role="status" aria-live="polite"></p>

    <div class="grid" id="post-grid">
      {
        posts.map((post) => (
          <div
            class="grid__item"
            data-category={categorySlug(post.data.category)}
            data-search={`${post.data.title} ${post.data.tags.join(' ')} ${post.data.category}`.toLowerCase()}
          >
            <PostCard post={post} headingLevel="h2" />
          </div>
        ))
      }
    </div>

    <p class="empty" id="empty-state" hidden>
      조건에 맞는 글이 없습니다. 다른 키워드로 검색해 보세요.
    </p>

    <AdSlot variant="banner" label="광고" />
  </div>
</Layout>

<style>
  .page {
    padding-block: 3rem 4rem;
  }

  .page__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .page__head h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .page__desc {
    margin-top: 0.75rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .toolbar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-block: 2rem 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background-color: var(--surface-raised);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .filter:hover {
    background-color: var(--surface-muted);
    color: var(--text);
  }

  .filter.is-active {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .filter__count {
    font-size: 0.72rem;
    opacity: 0.75;
  }

  .search input {
    width: 100%;
    padding: 0.65rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    background-color: var(--surface-raised);
    color: var(--text);
    font-size: 0.925rem;
  }

  .search input::placeholder {
    color: var(--text-subtle);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .result-count {
    margin-bottom: 1.25rem;
    font-size: 0.8rem;
    color: var(--text-subtle);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .grid__item[hidden] {
    display: none;
  }

  .empty {
    padding: 3rem 1.5rem;
    text-align: center;
    color: var(--text-subtle);
    border: 1px dashed var(--border);
    border-radius: 1rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .search {
      flex: none;
      width: 16rem;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  const items = Array.from(
    document.querySelectorAll<HTMLElement>('#post-grid .grid__item'),
  );
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
  const search = document.getElementById('post-search') as HTMLInputElement | null;
  const counter = document.getElementById('result-count');
  const emptyState = document.getElementById('empty-state');

  let activeCategory = 'all';

  function apply() {
    const query = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;

    for (const item of items) {
      const categoryOk =
        activeCategory === 'all' || item.dataset.category === activeCategory;
      const searchOk = query === '' || (item.dataset.search ?? '').includes(query);
      const show = categoryOk && searchOk;
      item.hidden = !show;
      if (show) visible += 1;
    }

    if (counter) counter.textContent = `${visible}편의 글을 보고 있습니다.`;
    if (emptyState) emptyState.hidden = visible !== 0;
  }

  function setCategory(slug: string) {
    activeCategory = slug;
    for (const button of buttons) {
      const isActive = button.dataset.filter === slug;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    }
    apply();
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const slug = button.dataset.filter ?? 'all';
      setCategory(slug);
      const url = new URL(window.location.href);
      if (slug === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', slug);
      window.history.replaceState({}, '', url);
    });
  }

  search?.addEventListener('input', apply);

  // Honor ?category=... links coming from the header, footer and home page.
  const initial = new URL(window.location.href).searchParams.get('category');
  if (initial && buttons.some((button) => button.dataset.filter === initial)) {
    setCategory(initial);
  } else {
    apply();
  }
</script>
