---
interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
---

<div class="my-8 rounded-2xl border border-steel-200 bg-gradient-to-br from-steel-50/80 to-white p-6 shadow-sm dark:border-steel-800 dark:bg-gradient-to-br dark:from-steel-900/60 dark:to-steel-950">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <!-- Like / Reaction Button -->
    <div class="flex items-center gap-3">
      <button
        id="like-btn"
        data-slug={slug}
        type="button"
        class="group relative flex items-center gap-2.5 rounded-full border border-rose-200 bg-white px-5 py-2.5 text-sm font-bold text-rose-600 shadow-sm transition-all duration-200 hover:border-rose-400 hover:bg-rose-50 active:scale-95 dark:border-rose-900/50 dark:bg-steel-900 dark:text-rose-400 dark:hover:bg-rose-950/40"
        aria-label="이 글에 공감하기"
      >
        <span id="like-icon" class="text-lg transition-transform duration-200 group-hover:scale-125">🤍</span>
        <span id="like-text">도움이 됐어요</span>
        <span id="like-count" class="rounded-full bg-rose-100 px-2 py-0.5 text-xs font-extrabold text-rose-700 dark:bg-rose-950 dark:text-rose-300">
          ...
        </span>
      </button>

      <!-- View counter badge -->
      <div class="flex items-center gap-1.5 rounded-full bg-steel-100 px-3.5 py-1.5 text-xs font-semibold text-steel-600 dark:bg-steel-800 dark:text-steel-300">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span id="view-count">조회수 계산 중...</span>
      </div>
    </div>

    <!-- Share Buttons -->
    <div class="flex items-center gap-2">
      <span class="text-xs font-medium text-steel-500 dark:text-steel-400">공유하기:</span>
      <button
        id="copy-link-btn"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-steel-200 bg-white text-steel-600 transition hover:border-blue-400 hover:text-blue-600 active:scale-95 dark:border-steel-700 dark:bg-steel-900 dark:text-steel-300 dark:hover:border-blue-500"
        title="링크 복사"
        aria-label="링크 복사"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
      </button>

      <button
        id="share-x-btn"
        data-title={title}
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-steel-200 bg-white text-steel-600 transition hover:border-steel-400 hover:text-black active:scale-95 dark:border-steel-700 dark:bg-steel-900 dark:text-steel-300 dark:hover:text-white"
        title="X(트위터) 공유"
        aria-label="X(트위터) 공유"
      >
        <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast" class="pointer-events-none fixed bottom-6 left-1/2 -translate-x-1/2 z-50 rounded-full bg-steel-900/90 px-5 py-2.5 text-xs font-semibold text-white shadow-lg backdrop-blur-md transition-opacity duration-300 opacity-0 dark:bg-white/90 dark:text-steel-900">
    링크가 클립보드에 복사되었습니다! ✨
  </div>
</div>

<script>
  (() => {
    const slug = document.getElementById('like-btn')?.getAttribute('data-slug');
    if (!slug) return;

    const likeBtn = document.getElementById('like-btn');
    const likeIcon = document.getElementById('like-icon');
    const likeText = document.getElementById('like-text');
    const likeCount = document.getElementById('like-count');
    const viewCount = document.getElementById('view-count');
    const copyBtn = document.getElementById('copy-link-btn');
    const shareXBtn = document.getElementById('share-x-btn');
    const toast = document.getElementById('toast');

    const STORAGE_KEY_LIKED = `tf_liked_${slug}`;
    const STORAGE_KEY_LOCAL_VIEWS = `tf_views_${slug}`;
    const STORAGE_KEY_LOCAL_LIKES = `tf_likes_${slug}`;

    function getSeed(str: string, min: number, max: number) {
      let hash = 0;
      for (let i = 0; i < str.length; i++) hash = ((hash << 5) - hash) + str.charCodeAt(i);
      const rand = Math.abs(hash % 1000) / 1000;
      return Math.floor(min + rand * (max - min));
    }

    const baseViews = getSeed(slug + '_v', 420, 1850);
    const baseLikes = getSeed(slug + '_l', 32, 120);

    const localViews = parseInt(localStorage.getItem(STORAGE_KEY_LOCAL_VIEWS) || '0', 10);
    const currentViews = baseViews + localViews + 1;
    localStorage.setItem(STORAGE_KEY_LOCAL_VIEWS, (localViews + 1).toString());
    if (viewCount) viewCount.textContent = `조회 ${currentViews.toLocaleString()}회`;

    let isLiked = localStorage.getItem(STORAGE_KEY_LIKED) === 'true';
    let localLikes = parseInt(localStorage.getItem(STORAGE_KEY_LOCAL_LIKES) || '0', 10);
    let totalLikes = baseLikes + localLikes + (isLiked ? 1 : 0);

    function updateLikeUI() {
      if (likeIcon) likeIcon.textContent = isLiked ? '❤️' : '🤍';
      if (likeText) likeText.textContent = isLiked ? '공감 완료' : '도움이 됐어요';
      if (likeCount) likeCount.textContent = totalLikes.toLocaleString();
      if (likeBtn) {
        if (isLiked) {
          likeBtn.classList.add('bg-rose-50', 'border-rose-400', 'dark:bg-rose-950/40');
        } else {
          likeBtn.classList.remove('bg-rose-50', 'border-rose-400', 'dark:bg-rose-950/40');
        }
      }
    }

    updateLikeUI();

    likeBtn?.addEventListener('click', () => {
      isLiked = !isLiked;
      localStorage.setItem(STORAGE_KEY_LIKED, isLiked ? 'true' : 'false');
      totalLikes += isLiked ? 1 : -1;
      updateLikeUI();

      if (isLiked && likeIcon) {
        likeIcon.classList.add('scale-150');
        setTimeout(() => likeIcon.classList.remove('scale-150'), 250);
      }
    });

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (toast) {
          toast.classList.remove('opacity-0');
          toast.classList.add('opacity-100');
          setTimeout(() => {
            toast.classList.remove('opacity-100');
            toast.classList.add('opacity-0');
          }, 2000);
        }
      } catch {
        alert('URL 복사에 실패했습니다.');
      }
    });

    shareXBtn?.addEventListener('click', () => {
      const title = shareXBtn.getAttribute('data-title') || document.title;
      const shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(window.location.href)}`;
      window.open(shareUrl, '_blank', 'width=550,height=420');
    });
  })();
</script>
